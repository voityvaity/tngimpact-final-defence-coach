# Safe default: the full app works without an external API.
DEMO_MODE=true

# If live AI is enabled and the provider fails, keep the session usable
# with deterministic local coaching instead of crashing the demo.
AI_FALLBACK_TO_DEMO=true

# OpenAI-compatible provider settings.
# Leave the key empty in Git. Put the real key only in your local .env or
# deployment secret store.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# CheapVibeCode / PromptPort example:
# DEMO_MODE=false
# LLM_API_KEY=your_private_key_here
# LLM_BASE_URL=https://cheapvibecode.ru/v1
# LLM_MODEL=gpt-5.6-sol
